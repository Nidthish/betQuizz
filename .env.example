# ==============================================================================
# QUIZ BETTING GAME - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Connection String (Neon Serverless PostgreSQL)
# Example: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct URL for Prisma Migrations (Neon non-pooled connection if using PgBouncer)
DIRECT_URL="postgresql://neondb_owner:npg_placeholder@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session & JWT Secrets (generate with `openssl rand -base64 32`)
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars-long"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Admin Initial Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@quizbetting.com"
ADMIN_DEFAULT_PASSWORD="AdminPassword123!"

# Game Engine Tuning
DEFAULT_STARTING_BALANCE=10000
DEFAULT_REFILL_AMOUNT=10000
DEFAULT_REFILL_FEE=1000
DEFAULT_QUESTION_TIME_LIMIT=30
MAX_PLAYERS_PER_GAME=500
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_WINDOW_MS=60000
